# =============================================================================
# PEPS VBC Mail Configuration
# =============================================================================
# Copy this file to .env and customize for your setup.
# All values shown are defaults (used when the variable is unset).

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
HOST=0.0.0.0                    # Bind address
PORT=3001                       # HTTP port
ENVIRONMENT=production          # development = no Secure cookies + open CORS (local HTTP only)
PUBLISH_ADDRESS=127.0.0.1       # Docker Compose: host address for port 3001 (0.0.0.0 if the proxy is on another machine)
TRUSTED_PROXIES=172.16.0.0/12   # IPs/CIDRs whose X-Forwarded-For is trusted for login rate limiting

# -----------------------------------------------------------------------------
# Mail Server (IMAP)
# -----------------------------------------------------------------------------
IMAP_HOST=                      # IMAP server hostname (required)
IMAP_PORT=993                   # Implicit TLS; IMAP STARTTLS is not supported

# -----------------------------------------------------------------------------
# Mail Server (SMTP)
# -----------------------------------------------------------------------------
SMTP_HOST=                      # SMTP server hostname (required)
SMTP_PORT=587                   # SMTP port (587 for STARTTLS, 465 for TLS)

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
TLS_ENABLED=true                # Enable TLS for mail connections
SESSION_TIMEOUT_HOURS=24        # Session expiry in hours (sliding window)
ALLOWED_EMAIL_DOMAINS=          # e.g. pepsvbc.ch,pepsvolley.ch — only these domains may sign in (empty = any)
LOGIN_DEFAULT_DOMAIN=          # Short login names use this domain; empty uses the sole allowed domain
ADMIN_EMAILS=                   # e.g. coach@pepsvbc.ch — admins manage shared distribution lists
ALLOW_ANY_SENDER=false         # true lets identities use any From address; only if the SMTP server enforces sender ownership

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
DATA_DIR=/data                  # Persistent data directory (SQLite + Tantivy indexes)
STATIC_DIR=/app/static          # Frontend static files directory

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
RUST_LOG=info                   # Log level (trace, debug, info, warn, error)

# -----------------------------------------------------------------------------
# Optional FranklyMail integration (server-side only; disabled by default)
# -----------------------------------------------------------------------------
# Never use NEXT_PUBLIC_ for these values.
FRANKLYMAIL_ENABLED=false
FRANKLYMAIL_API_KEY=             # Management key from FranklyMail Settings → API keys
FRANKLYMAIL_DOMAINS=             # e.g. pepsvbc.ch — exact domains admins may manage
# Mailboxes that may administer FranklyMail users (create/delete mailboxes,
# set recovery addresses, forwarding). Separate from ADMIN_EMAILS, which only
# manages distribution lists. Empty = user administration is off.
# Administrators cannot change each other's mailboxes; every change is logged
# (log target "audit") and the mailbox owner is emailed about recovery and
# forwarding changes.
FRANKLYMAIL_ADMIN_EMAILS=        # e.g. it@pepsvbc.ch
# Mail server hosts/ports reuse IMAP_HOST/IMAP_PORT and SMTP_HOST/SMTP_PORT above.
# Email delivery requires TLS_ENABLED=true.
# Configure all email fields below to enable creation/invitations/password recovery.
FRANKLYMAIL_PUBLIC_URL=          # Public HTTPS app URL, including BASE_PATH if set
FRANKLYMAIL_MAIL_FROM=           # e.g. noreply@pepsvbc.ch or an authorized admin address
FRANKLYMAIL_SMTP_USERNAME=       # Login for the configured sender
FRANKLYMAIL_SMTP_PASSWORD=       # Sender password; never sent to browsers
# Optional template paths inside the server/container. Each email sends both
# a plain-text fallback and styled HTML with a button and visible URL.
# Required placeholder: {{link}}. Optional: {{mailbox}}. Defaults are bundled.
FRANKLYMAIL_WELCOME_TEMPLATE_PATH=
FRANKLYMAIL_RESET_TEMPLATE_PATH=
FRANKLYMAIL_WELCOME_HTML_TEMPLATE_PATH=
FRANKLYMAIL_RESET_HTML_TEMPLATE_PATH=
