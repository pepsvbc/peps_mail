# =============================================================================
# PEPS VBC Mail Configuration
# =============================================================================
# Copy this file to .env and customize for your setup.
# All values shown are defaults (used when the variable is unset).

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
HOST=0.0.0.0                    # Bind address
PORT=3001                       # HTTP port
ENVIRONMENT=production          # development = no Secure cookies + open CORS (local HTTP only)
PUBLISH_ADDRESS=127.0.0.1       # Docker Compose: host address for port 3001 (0.0.0.0 if the proxy is on another machine)
TRUSTED_PROXIES=172.16.0.0/12   # IPs/CIDRs whose X-Forwarded-For is trusted for login rate limiting

# -----------------------------------------------------------------------------
# Mail Server (IMAP)
# -----------------------------------------------------------------------------
IMAP_HOST=                      # IMAP server hostname (required)
IMAP_PORT=993                   # Implicit TLS; IMAP STARTTLS is not supported

# -----------------------------------------------------------------------------
# Mail Server (SMTP)
# -----------------------------------------------------------------------------
SMTP_HOST=                      # SMTP server hostname (required)
SMTP_PORT=587                   # SMTP port (587 for STARTTLS, 465 for TLS)

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
TLS_ENABLED=true                # Enable TLS for mail connections
SESSION_TIMEOUT_HOURS=24        # Session expiry in hours (sliding window)
ALLOW_ANY_SENDER=false          # true lets identities use any From address; only if the SMTP server enforces sender ownership

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
DATA_DIR=/data                  # Persistent data directory (SQLite + Tantivy indexes)
STATIC_DIR=/app/static          # Frontend static files directory

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
RUST_LOG=info                   # Log level (trace, debug, info, warn, error)
